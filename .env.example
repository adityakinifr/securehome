# Google Cloud / SDM API credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
SDM_PROJECT_ID=your-sdm-project-id

# Google Cloud Pub/Sub (for camera/doorbell events)
PUBSUB_PROJECT_ID=your-gcp-project-id
PUBSUB_SUBSCRIPTION_ID=your-subscription-id

# App settings
NIGHT_CHECK_HOUR=22
NIGHT_CHECK_MINUTE=0
SUMMARY_HOUR=21
SUMMARY_MINUTE=0
TOKEN_PATH=config/token.json
