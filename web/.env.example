# NextAuth
NEXTAUTH_SECRET=generate-a-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (same credentials as SDM setup)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
SDM_PROJECT_ID=your-sdm-project-id

# Schlage
SCHLAGE_USERNAME=your-schlage-email
SCHLAGE_PASSWORD=your-schlage-password

# TP-Link Kasa
KASA_USERNAME=your-tplink-email
KASA_PASSWORD=your-tplink-password

# Vercel KV (auto-populated when you link a KV store on Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Pub/Sub
PUBSUB_PROJECT_ID=your-gcp-project-id
